{
  "name": "foodnet-backend",
  "version": "1.0.0",
  "description": "Standalone Express backend and BullMQ worker for FoodNet",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "worker": "tsx watch src/workers/analyze.worker.ts",
    "worker:prod": "node dist/workers/analyze.worker.js",
    "cleanup:uploads": "tsx src/scripts/cleanupUploads.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^7.61.0",
    "bullmq": "^1.82.0",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "pg": "^8.22.0",
    "pino": "^8.14.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
